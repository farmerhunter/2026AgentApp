#!/usr/bin/env bash
set -euo pipefail

# E6 private operator: only touches the synthetic production data root.
# It does not call OCR/Hermes and does not touch Chatbox, port 3000, Nginx or Git.

PROD_ROOT="${XUETUZHIBAN_PROD_ROOT:-/opt/hermes/2026agentapp-prod}"
DATA_ROOT="$PROD_ROOT/data"
SNAPSHOT_ROOT="$PROD_ROOT/snapshots"
API_SERVICE="xuetuzhiban-api.service"
API_BASE="http://127.0.0.1:8001"

die() {
  echo "xuetuzhiban-demo: $*" >&2
  exit 1
}

backup_sqlite() {
  local src="$1"
  local dst="$2"
  python3 - "$src" "$dst" <<'PY'
import sqlite3, sys
src, dst = sys.argv[1], sys.argv[2]
source = sqlite3.connect(src)
target = sqlite3.connect(dst)
with target:
    source.backup(target)
target.close()
source.close()
PY
}

assert_name() {
  local name="$1"
  [[ "$name" == "baseline-ab" || "$name" == "showcase-abc" || "$name" == "last-run" ]] || die "unknown snapshot name: $name"
}

snapshot_path() {
  local name="$1"
  echo "$SNAPSHOT_ROOT/$name"
}

snapshot() {
  local name="$1"
  assert_name "$name"
  [[ "$name" != "last-run" ]] || die "last-run is reserved"
  local dest
  dest="$(snapshot_path "$name")"
  [[ ! -e "$dest" ]] || die "snapshot already exists: $name"

  mkdir -p "$SNAPSHOT_ROOT"
  local staging
  staging="$(mktemp -d "$SNAPSHOT_ROOT/.snapshot.XXXXXX")"
  backup_sqlite "$DATA_ROOT/sqlite/xuetuzhiban.db" "$staging/xuetuzhiban.db"
  cp -a "$DATA_ROOT/uploads" "$staging/uploads"
  python3 - "$staging/manifest.json" "$staging/xuetuzhiban.db" "$name" "$PROD_ROOT/app" "$DATA_ROOT/sqlite/xuetuzhiban.db" "$DATA_ROOT/uploads" <<'PY'
import hashlib, json, os, sqlite3, sys
manifest_path, snapshot_db, name, app_dir, live_db, uploads_root = sys.argv[1:7]
conn = sqlite3.connect(snapshot_db)
uploads = conn.execute("select upload_id, source_title from uploads order by upload_id").fetchall()
upload_counts = {u[0]: conn.execute("select count(*) from questions where upload_id=?", (u[0],)).fetchone()[0] for u in uploads}
confirmed = conn.execute("select count(*) from question_confirmations where selected=1").fetchone()[0]
confirmed_by_upload = {u[0]: conn.execute("select count(*) from question_confirmations c join questions q on q.question_id=c.question_id where q.upload_id=? and c.selected=1", (u[0],)).fetchone()[0] for u in uploads}
findings = conn.execute("select count(*) from findings").fetchone()[0]
memories = conn.execute("select count(*) from memory_decisions").fetchone()[0]
accepted_memories = conn.execute("select count(*) from memory_decisions where status='accepted'").fetchone()[0]
reports = conn.execute("select count(*) from weekly_reports").fetchone()[0]
active_jobs = conn.execute("select count(*) from hermes_jobs where status in ('queued','running','pending')").fetchone()[0]
map_row = conn.execute("select map_id, map_version from knowledge_map_registry where status='current' order by updated_at desc limit 1").fetchone()
report_rows = conn.execute("select report_json from weekly_reports where report_json is not null").fetchall()
evidence_ok = True
for (report_json,) in report_rows:
    parsed = json.loads(report_json)
    links = parsed.get("evidence_links", [])
    if not links:
        evidence_ok = False
        break
    for link in links:
        finding_ids = link.get("finding_ids", [])
        question_ids = link.get("question_ids", [])
        if not finding_ids or not question_ids:
            evidence_ok = False
            break
        for finding_id in finding_ids:
            if conn.execute("select count(*) from findings where finding_id=?", (finding_id,)).fetchone()[0] != 1:
                evidence_ok = False
        for qid in question_ids:
            row = conn.execute("select count(*) from questions q join question_confirmations c on c.question_id=q.question_id where q.question_id=? and c.selected=1", (qid,)).fetchone()[0]
            if row != 1:
                evidence_ok = False
        if not evidence_ok:
            break
conn.close()
if name == "baseline-ab":
    assert len(uploads) == 2, f"baseline-ab must have exactly 2 uploads, got {len(uploads)}"
    assert confirmed == 6, f"baseline-ab must have 6 confirmed questions, got {confirmed}"
    a_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-a" in (u[1] or "").lower())
    b_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-b" in (u[1] or "").lower())
    assert a_conf == 3 and b_conf == 3, f"baseline-ab must have A=3/B=3, got A={a_conf} B={b_conf}"
    assert findings >= 6, f"baseline-ab must have at least 6 findings, got {findings}"
    assert accepted_memories >= 2, f"baseline-ab must have at least 2 accepted memories, got {accepted_memories}"
    assert reports >= 1, f"baseline-ab must have at least 1 report, got {reports}"
    assert evidence_ok, "baseline-ab report evidence is missing or invalid"
    assert not any("worksheet-c" in (u[1] or "").lower() for u in uploads), "baseline-ab must not contain C"
elif name == "showcase-abc":
    assert len(uploads) == 3, f"showcase-abc must have exactly 3 uploads, got {len(uploads)}"
    assert confirmed == 8, f"showcase-abc must have 8 confirmed questions, got {confirmed}"
    a_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-a" in (u[1] or "").lower())
    b_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-b" in (u[1] or "").lower())
    c_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-c" in (u[1] or "").lower())
    assert (a_conf, b_conf, c_conf) == (3,3,2), f"showcase-abc must have A=3/B=3/C=2, got A={a_conf} B={b_conf} C={c_conf}"
    assert findings >= 8, f"showcase-abc must have at least 8 findings, got {findings}"
    assert accepted_memories >= 2, f"showcase-abc must have at least 2 accepted memories, got {accepted_memories}"
    assert reports >= 1, f"showcase-abc must have at least 1 report, got {reports}"
    assert evidence_ok, "showcase-abc report evidence is missing or invalid"
    assert any("worksheet-c" in (u[1] or "").lower() for u in uploads), "showcase-abc must contain C"
def sha(path):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(65536),b''): h.update(chunk)
    return h.hexdigest()
skills={
  "confirmed_mistake_analysis": sha(os.path.join(app_dir,'src/skills/confirmed_mistake_analysis.skill.md')),
  "weekly_learning_report": sha(os.path.join(app_dir,'src/skills/weekly_learning_report.skill.md')),
}
manifest={
  "name": name,
  "app_commit": os.popen(f"git -C {app_dir} rev-parse HEAD").read().strip() or "unknown",
  "schema_version": "e6",
  "created_at": os.popen("date -u +%Y-%m-%dT%H:%M:%SZ").read().strip(),
  "knowledge_map": {"map_id": map_row[0] if map_row else None, "map_version": map_row[1] if map_row else None},
  "skills": skills,
  "expected": {
    "upload_count": len(uploads),
    "confirmed_count": confirmed,
    "min_findings": findings,
    "min_memories": memories,
    "min_reports": reports,
    "active_jobs": active_jobs,
  },
  "uploads": [{"upload_id":u[0],"source_title":u[1],"question_count":upload_counts[u[0]]} for u in uploads],
}
with open(manifest_path,'w',encoding='utf-8') as f: json.dump(manifest,f,ensure_ascii=False,indent=2)
PY
  mv "$staging" "$dest"
  echo "snapshot $name created at $dest"
}

restore() {
  local name="$1"
  assert_name "$name"
  local src
  src="$(snapshot_path "$name")"
  [[ -f "$src/xuetuzhiban.db" && -f "$src/manifest.json" ]] || die "snapshot missing or corrupt: $name"

  python3 - "$src/manifest.json" "$PROD_ROOT/app" "$DATA_ROOT/sqlite/xuetuzhiban.db" <<'PY'
import hashlib, json, os, sqlite3, sys
manifest_path, app_dir, live_db = sys.argv[1:4]
manifest = json.load(open(manifest_path, encoding='utf-8'))
assert manifest.get("schema_version") == "e6", "schema_version mismatch"
def sha(path):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(65536),b''): h.update(chunk)
    return h.hexdigest()
for name, expected_hash in manifest.get("skills", {}).items():
    path = os.path.join(app_dir, "src/skills", f"{name.replace('-','_')}.skill.md")
    assert os.path.exists(path), f"missing skill file {path}"
    assert sha(path) == expected_hash, f"skill hash mismatch for {name}"
map_info = manifest.get("knowledge_map") or {}
if map_info.get("map_id"):
    conn = sqlite3.connect(live_db)
    row = conn.execute("select map_id, map_version from knowledge_map_registry where status='current' order by updated_at desc limit 1").fetchone()
    conn.close()
assert row and row[0] == map_info["map_id"] and row[1] == map_info["map_version"], "knowledge map mismatch"
PY

  local last
  last="$(snapshot_path "last-run")"
  switch_started=0
  local new_last
  new_last="$(mktemp -d "$SNAPSHOT_ROOT/.last.XXXXXX")"
  rollback() {
    trap - ERR
    systemctl stop "$API_SERVICE" || true
    rm -f "$DATA_ROOT/sqlite/xuetuzhiban.db-wal" "$DATA_ROOT/sqlite/xuetuzhiban.db-shm"
    mkdir -p "$DATA_ROOT/sqlite"
    if [[ "$switch_started" -eq 1 && -f "$new_last/xuetuzhiban.db" ]]; then
      cp -f "$new_last/xuetuzhiban.db" "$DATA_ROOT/sqlite/xuetuzhiban.db"
    fi
    if [[ "$switch_started" -eq 1 && -d "$new_last/uploads" ]]; then
      rm -rf "$DATA_ROOT/uploads"
      cp -a "$new_last/uploads" "$DATA_ROOT/uploads"
    fi
    chown -R ubuntu:ubuntu "$DATA_ROOT/sqlite" "$DATA_ROOT/uploads"
    systemctl start "$API_SERVICE"
    echo "restore failed; rolled back to last-run"
  }

  trap rollback ERR
  if [[ -f "$DATA_ROOT/sqlite/xuetuzhiban.db" ]]; then
    backup_sqlite "$DATA_ROOT/sqlite/xuetuzhiban.db" "$new_last/xuetuzhiban.db"
  fi
  if [[ -d "$DATA_ROOT/uploads" ]]; then
    cp -a "$DATA_ROOT/uploads" "$new_last/uploads"
  fi

  switch_started=1
  if systemctl is-active --quiet "$API_SERVICE"; then
    systemctl stop "$API_SERVICE"
  fi
  rm -f "$DATA_ROOT/sqlite/xuetuzhiban.db-wal" "$DATA_ROOT/sqlite/xuetuzhiban.db-shm"

  local staging
  staging="$(mktemp -d "$DATA_ROOT/.restore.XXXXXX")"
  cp -a "$src/." "$staging/"
  mkdir -p "$DATA_ROOT/sqlite"
  mv "$staging/xuetuzhiban.db" "$DATA_ROOT/sqlite/xuetuzhiban.db"
  rm -rf "$DATA_ROOT/uploads"
  mv "$staging/uploads" "$DATA_ROOT/uploads"
  rm -rf "$staging"
  chown -R ubuntu:ubuntu "$DATA_ROOT/sqlite" "$DATA_ROOT/uploads"

  systemctl start "$API_SERVICE"
  verify "$name"
  local old_last_tmp
  old_last_tmp="$(mktemp -u "$SNAPSHOT_ROOT/.last-old.XXXXXX")"
  if [[ -e "$last" ]]; then
    mv "$last" "$old_last_tmp"
  fi
  mv "$new_last" "$last"
  rm -rf "$old_last_tmp"
  trap - ERR
}

verify() {
  local name="$1"
  assert_name "$name"
  local manifest
  manifest="$(snapshot_path "$name")/manifest.json"
  for _ in $(seq 1 30); do
    curl -fsS "$API_BASE/api/health" >/dev/null && break
    sleep 1
  done
  curl -fsS "$API_BASE/api/health" >/dev/null || { echo "verify $name: API health failed" >&2; return 1; }

  python3 - "$DATA_ROOT/sqlite/xuetuzhiban.db" "$DATA_ROOT/uploads" "$manifest" "$PROD_ROOT/app" "$name" <<'PY'
import hashlib, json, os, sqlite3, sys
db_path, uploads_root, manifest_path, app_dir, name = sys.argv[1:6]
manifest = json.load(open(manifest_path, encoding='utf-8'))
assert manifest.get("name") == name, "manifest name mismatch"
assert manifest.get("schema_version") == "e6", "schema_version mismatch"
current_commit = os.popen(f"git -C {app_dir} rev-parse HEAD").read().strip()
assert manifest.get("app_commit") == current_commit, f"app_commit mismatch: manifest={manifest.get('app_commit')} current={current_commit}"
expected = manifest.get("expected", {})
conn = sqlite3.connect(db_path)
uploads = conn.execute("select upload_id, source_title from uploads").fetchall()
ids = [u[0] for u in uploads]
titles = [u[1] or '' for u in uploads]
assert len(uploads) == expected.get("upload_count", 2), f"expected {expected.get('upload_count',2)} active uploads, got {len(uploads)}"
assert any('worksheet-a' in t.lower() for t in titles), "A worksheet missing"
assert any('worksheet-b' in t.lower() for t in titles), "B worksheet missing"
if name == "baseline-ab":
    assert not any('worksheet-c' in t.lower() for t in titles), "C worksheet is still active in baseline-ab"
else:
    assert any('worksheet-c' in t.lower() for t in titles), "C worksheet missing in showcase"
confirmed = conn.execute("select count(*) from question_confirmations where selected=1").fetchone()[0]
assert confirmed == expected.get("confirmed_count", 6), f"expected {expected.get('confirmed_count',6)} confirmed wrong questions, got {confirmed}"
confirmed_by_upload = {u[0]: conn.execute("select count(*) from question_confirmations c join questions q on q.question_id=c.question_id where q.upload_id=? and c.selected=1", (u[0],)).fetchone()[0] for u in uploads}
if name == "baseline-ab":
    a_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-a" in (u[1] or "").lower())
    b_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-b" in (u[1] or "").lower())
    assert a_conf == 3 and b_conf == 3, f"baseline-ab must have A=3/B=3, got A={a_conf} B={b_conf}"
elif name == "showcase-abc":
    a_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-a" in (u[1] or "").lower())
    b_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-b" in (u[1] or "").lower())
    c_conf = sum(confirmed_by_upload[u[0]] for u in uploads if "worksheet-c" in (u[1] or "").lower())
    assert (a_conf, b_conf, c_conf) == (3,3,2), f"showcase-abc must have A=3/B=3/C=2, got A={a_conf} B={b_conf} C={c_conf}"
findings = conn.execute("select count(*) from findings").fetchone()[0]
assert findings >= expected.get("min_findings", 6), f"expected at least {expected.get('min_findings',6)} findings, got {findings}"
memories = conn.execute("select count(*) from memory_decisions").fetchone()[0]
assert memories >= expected.get("min_memories", 3), f"expected at least {expected.get('min_memories',3)} memory decisions, got {memories}"
accepted_memories = conn.execute("select count(*) from memory_decisions where status='accepted'").fetchone()[0]
assert accepted_memories >= 2, f"expected at least 2 accepted memories, got {accepted_memories}"
reports = conn.execute("select count(*) from weekly_reports").fetchone()[0]
assert reports >= expected.get("min_reports", 1), f"expected at least {expected.get('min_reports',1)} weekly report, got {reports}"
active_jobs = conn.execute("select count(*) from hermes_jobs where status in ('queued','running','pending')").fetchone()[0]
assert active_jobs == 0, f"expected no active jobs, got {active_jobs}"
ocr_active = conn.execute("select count(*) from ocr_jobs where is_latest=1 and status in ('queued','running')").fetchone()[0]
assert ocr_active == 0, f"expected no active OCR jobs, got {ocr_active}"
manifest_uploads = {u["upload_id"]: u for u in manifest.get("uploads", [])}
db_uploads = {u[0] for u in uploads}
assert set(manifest_uploads.keys()) == db_uploads, "manifest upload identities do not match DB"
dirs = set(os.listdir(uploads_root))
assert dirs == db_uploads, f"orphan or missing upload dirs: db={db_uploads} dirs={dirs}"
for uid in db_uploads:
    q = conn.execute("select question_id from questions where upload_id=?", (uid,)).fetchall()
    expected_q = manifest_uploads[uid].get("question_count", 10)
    assert len(q) == expected_q, f"expected {expected_q} questions for {uid}, got {len(q)}"
    for (qid,) in q:
        row = conn.execute("select count(*) from question_confirmations where question_id=? and selected=1", (qid,)).fetchone()[0]
        # Baseline: exactly three confirmed per batch; show-case adds two on C.
        pass
for uid in ids:
    assert os.path.isdir(os.path.join(uploads_root, uid)), f"uploads dir missing for {uid}"
def sha(path):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(65536),b''): h.update(chunk)
    return h.hexdigest()
for skill_name, expected_hash in manifest.get("skills", {}).items():
    skill_file = os.path.join(app_dir, "src/skills", skill_name.replace("-", "_") + ".skill.md")
    assert sha(skill_file) == expected_hash, f"skill hash mismatch for {skill_name}"
map_info = manifest.get("knowledge_map") or {}
if map_info.get("map_id"):
    map_row = conn.execute("select map_id, map_version from knowledge_map_registry where status='current' order by updated_at desc limit 1").fetchone()
    assert map_row and map_row[0] == map_info["map_id"] and map_row[1] == map_info["map_version"], "knowledge map mismatch"
report_rows = conn.execute("select report_json from weekly_reports where report_json is not null").fetchall()
assert report_rows, "expected a stored weekly report"
for (report_json,) in report_rows:
    parsed = json.loads(report_json)
    assert isinstance(parsed.get("analysis"), dict) and parsed["analysis"].get("overall_summary"), "report missing analysis summary"
    assert parsed.get("evidence_links"), "report evidence_links is empty"
    for link in parsed.get("evidence_links", []):
        finding_ids = link.get("finding_ids", [])
        question_ids = link.get("question_ids", [])
        assert finding_ids and question_ids, "evidence link must contain finding_ids and question_ids"
        for finding_id in finding_ids:
            assert conn.execute("select count(*) from findings where finding_id=?", (finding_id,)).fetchone()[0] == 1, f"report references missing finding {finding_id}"
        for qid in question_ids:
            assert conn.execute("select count(*) from question_confirmations where question_id=? and selected=1", (qid,)).fetchone()[0] == 1, f"report references unconfirmed or missing question {qid}"
conn.close()
print("verify data: manifest contract satisfied")
PY
}

case "${1:-}" in
  snapshot) shift; snapshot "${1:?name required}" ;;
  restore) shift; restore "${1:?name required}" ;;
  verify) shift; verify "${1:?name required}" || exit 1 ;;
  *) die "usage: $0 {snapshot|restore|verify} baseline-ab" ;;
esac
