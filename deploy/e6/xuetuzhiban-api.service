[Unit]
Description=XueTuZhiBan P0 disabled API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hermes/2026agentapp-prod/app/src/api
Environment=HERMES_API_PORT=8001
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
