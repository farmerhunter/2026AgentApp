[Unit]
Description=XueTuZhiBan V2 API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hermes/2026agentapp-prod/app/src/api
EnvironmentFile=/opt/hermes/2026agentapp-prod/env/xuetuzhiban.env
EnvironmentFile=-/opt/hermes/.secrets/2026agentapp/dev/tencent-ocr.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
